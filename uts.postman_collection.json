        {
          "name": "S01 - GET Semua Kategori",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                "const res = pm.response.json();",
                "pm.test('Struktur & minimal 3 kategori awal', () => {",
                "  pm.expect(res.status).to.eql('success');",
                "  pm.expect(res.data).to.be.an('array');",
                "  pm.expect(res.count).to.be.at.least(3);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/kategori"
          }
        },
        {
          "name": "S02 - GET Detail Kategori id=1",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                "const res = pm.response.json();",
                "pm.test('Detail kategori sesuai', () => {",
                "  pm.expect(res.status).to.eql('success');",
                "  pm.expect(res.data.id).to.eql(1);",
                "  pm.expect(res.data).to.have.property('nama_kategori');",
